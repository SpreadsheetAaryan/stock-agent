    {
      "parameters": {
        "jsCode": "const output = JSON.parse($input.first().json.stdout);\nreturn [{\n  json: output\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        256
      ],
      "id": "2b00a1bc-2304-4376-a305-acef87d1f090",
      "name": "Parse Date"
    },
    {
      "parameters": {
        "jsCode": "// Get the items from the previous node (the Google Search output)\nconst searchResults = $input.first().json.feed;\n\n// Get the current ticker from another workflow\nconst currentTicker = $('When Executed by Another Workflow').first().json.ticker;\n\n// Check if search results exist\nif (!searchResults) {\n  return [{\n    json: {\n      cleaned_news_data: \"No recent news found for this company.\"\n    }\n  }];\n}\n\nconst searchResultsTen = searchResults.slice(0, 5);\n\nconst cleanedNewsData = searchResultsTen.map(result => {\n  const title = result.title;\n  const link = result.url;\n  const summary = result.summary;\n\n  // Try to find ticker sentiment for the current ticker\n  let tickerLabel = \"Not Mentioned\";\n  if (result.ticker_sentiment && Array.isArray(result.ticker_sentiment)) {\n    const match = result.ticker_sentiment.find(t => t.ticker === currentTicker);\n    if (match) {\n      tickerLabel = match.ticker_sentiment_label;\n    }\n  }\n\n  return `Title: ${title}\\nLink: ${link}\\nSummary: ${summary}\\nTicker Sentiment (${currentTicker}): ${tickerLabel}\\n`;\n}).join('');\n\nreturn [{\n  json: {\n    cleaned_news_data: cleanedNewsData\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1776,
        384
      ],
      "id": "d271c0e0-67ea-4c04-8b81-f32e63317ed0",
      "name": "Parse News"
    },
    {
      "parameters": {
        "jsCode": "// Assuming your text is coming from the previous node as 'content'\nconst inputText = $input.first().json.content.parts[0].text\n\n// A simple way to handle potential markdown issues is to replace the characters\nconst safeText = inputText\n  .replace(/\\*/g, '\\\\*')  // Escape asterisks\n  .replace(/_/g, '\\\\_')  // Escape underscores\n  .replace(/\\[/g, '\\\\[')  // Escape brackets\n  .replace(/`/g, '\\\\`');  // Escape backticks\n\n// Or, if you want to remove them altogether\n// const safeText = inputText.replace(/[*_`]/g, '');\n\nreturn {\n  json: {\n    safeText: safeText\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
