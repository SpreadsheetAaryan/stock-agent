        "messages": {
          "values": [
            {
              "content": "=Analyze the following news articles of the day. After analyzing the articles, return a response in the requested format. Do not add any words or extra information to the response besides the requested response format.\n\nNews Articles: {{ $json.cleaned_news_data }}\n\nRequested Response Format For Each Article: \n\nNews on {{ $('When Executed by Another Workflow').item.json.ticker }}: \n\nNow for each article, do this:\n\nTitle: Put the title of the article\n(put a space)\nSentiment Value: Just put the overall sentiment label for the article that I gave you as context. Example: Semi-Bullish\n(put a space)\nSummary of article: Write a SHORT paragraph summarizing the article, and its potential impact on the market/sector (depending on the context). \n\nThen put 2 spaces between each article\n\nremember to use this format for every article. Do not put any extra information other than the requested format."
            }
          ]
        },
        "options": {}
      },
